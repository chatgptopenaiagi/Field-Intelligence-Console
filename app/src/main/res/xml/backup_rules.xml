<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for Field Intelligence Console.
  Exclude the encrypted key store prefs from cloud backup — keys must be
  re-entered on a new device (they are bound to the Keystore of the original device).
-->
<full-backup-content>
    <exclude domain="sharedpref" path="fic_secure_prefs.xml" />
</full-backup-content>
